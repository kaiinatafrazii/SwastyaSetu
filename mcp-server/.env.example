# Rural Emergency Assistance Platform — MCP Server Configuration

# Optional: Google Gemini API Key for AI symptom reasoning (falls back to deterministic keyword rules if absent)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: URL of running Express Backend (defaults to direct backend service execution if not running)
BACKEND_URL=http://localhost:5000/api

# Optional: Log level (debug, info, warn, error) — logs are directed exclusively to stderr
LOG_LEVEL=info
